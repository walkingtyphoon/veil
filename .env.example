# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web).
# These are client identifiers, not secrets, but keep real values out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check: reCAPTCHA Enterprise site key for production. In dev the debug provider is used.
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_APPCHECK_DEBUG=false
